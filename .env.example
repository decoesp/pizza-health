# URL pública usada em metadata, links e cookies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "local" usa SQLite em .data/pizza-health.db (sem dependências externas).
# "remote" usa o banco PizzaSQL fornecido.
DB_MODE=local
LOCAL_DB_PATH=.data/pizza-health.db

# Banco remoto (necessário apenas com DB_MODE=remote).
PIZZA_API_KEY=
PIZZA_DB=pizzaria/pizza-health
PIZZA_DB_HOST=db.database.pizza
PIZZA_DB_PORT=5432
DATABASE_POOL_MAX=2

# Chave de criptografia dos documentos (AES-256-GCM).
# Gere com: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=

# Limite por arquivo. O Server Action aceita até 12 MB de corpo; 8 MB é o teto
# de domínio para manter documentos e exportações dentro de limites razoáveis.
MAX_UPLOAD_BYTES=8388608

# Sessões
SESSION_DAYS=30
# Sal para hashes de IP em auditoria/rate limit. Gere com: openssl rand -base64 24
RATE_LIMIT_SALT=

# Seed idempotente. Para desenvolvimento com dados demo, use SEED_DEMO=1.
# Em produção, mantenha 0 e defina uma senha administrativa forte.
SEED_DEMO=0
SEED_DEMO_PASSWORD=
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=

# Somente para desenvolvimento/testes automatizados.
# Nunca habilite em produção.
ALLOW_RESET_LINK_IN_UI=0

# Pizza Auth (OIDC authorization code + PKCE S256).
# O client já está provisionado; nunca versione o segredo.
OIDC_ISSUER=https://auth.pizzaria.foundation
OIDC_CLIENT_ID=pizza-healt
OIDC_CLIENT_SECRET=
# Produção: https://health.pizzaria.foundation/auth/callback (URI registrada).
# Desenvolvimento: http://localhost:3000/auth/callback (URI registrada).
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Passkeys (WebAuthn). Em produção, use o host canônico do app.
# O padrão é o hostname de NEXT_PUBLIC_SITE_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Pizza Health

# Limite do export.zip do Apple Saúde (padrão 50 MB, máximo 200 MB).
MAX_APPLE_IMPORT_BYTES=52428800

